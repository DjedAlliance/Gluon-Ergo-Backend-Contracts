# Secrets only: every public deployment parameter lives in config/. Copy this file to .env, which git ignores.
#
# Mnemonic of the wallet that signs and pays. The scripts use its first address (EIP-3 path m/44'/429'/0'/0/0):
# the deployer for scripts/bootstrap.ts, the current treasury for scripts/update-treasury.ts, and any funded
# wallet for scripts/adjust-peg.ts. scripts/testnet-oracle.ts also uses its second address (index 1).
MNEMONIC=
# Optional mnemonic password (the BIP-39 passphrase), if the wallet has one.
MNEMONIC_PASSWORD=
